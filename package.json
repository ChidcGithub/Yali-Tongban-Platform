    "db:init": "wrangler d1 execute yali-tongban-db --file=schema.sql"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "vite": "^7.3.6",
    "wrangler": "^4.101.0"
  }
}
