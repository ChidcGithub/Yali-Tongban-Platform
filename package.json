{
  "name": "yali-tongban",
  "version": "3.0.0",
  "private": true,
  "description": "雅礼团委-通办 工作管理平台",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:pages": "wrangler pages dev dist/",
